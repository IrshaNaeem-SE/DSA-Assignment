public class OneDArray {
    public static void main(String[] args) {

        int[] arr = {10, 20, 30, 40, 50};
        int n = 5;
        int i = 0;

        // 1. Traversal
        System.out.println("Array elements:");
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }

        // 2. Insertion at index 2
        int position = 2;
        int value = 25;

        i = n - 1;
        while (i >= position) {
            arr[i + 1] = arr[i];
            i--;
        }

        arr[position] = value;
        n++;

        System.out.println("\nAfter insertion:");
        i = 0;
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }

        // 3. Deletion at index 2
        position = 2;

        i = position;
        while (i < n - 1) {
            arr[i] = arr[i + 1];
            i++;
        }

        n--;

        System.out.println("\nAfter deletion:");
        i = 0;
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }

        // 4. Searching
        int search = 40;
        i = 0;
        int found = -1;

        while (i < n) {
            if (arr[i] == search) {
                found = i;
                break;
            }
            i++;
        }

        if (found != -1) {
            System.out.println("\nElement found at index: " + found);
        } else {
            System.out.println("\nElement not found");
        }

        // 5. Updating
        position = 1;
        arr[position] = 99;

        System.out.println("After updating:");
        i = 0;
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }
    }
}

