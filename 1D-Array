public class OneDArray {
    public static void main(String[] args) {

        int[] arr = new int[10];

        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;
        arr[4] = 50;

        int n = 5;
        int i = 0;

        // 1. Traversal
        System.out.print("Original Array: ");
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }

        // 2. Insertion at index 2
        int position = 2;
        int value = 25;

        i = n - 1;
        while (i >= position) {
            arr[i + 1] = arr[i];
            i--;
        }

        arr[position] = value;
        n++;

        System.out.print("\nAfter Insertion: ");
        i = 0;
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }

        // 3. Deletion at index 3
        position = 3;

        i = position;
        while (i < n - 1) {
            arr[i] = arr[i + 1];
            i++;
        }

        n--;

        System.out.print("\nAfter Deletion: ");
        i = 0;
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }

        // 4. Searching for 40
        int search = 40;
        int found = -1;
        i = 0;

        while (i < n) {
            if (arr[i] == search) {
                found = i;
                break;
            }
            i++;
        }

        if (found != -1) {
            System.out.println("\n40 found at index: " + found);
        } else {
            System.out.println("\n40 not found");
        }

        // 5. Updating index 1
        position = 1;
        arr[position] = 99;

        System.out.print("After Updating: ");
        i = 0;
        while (i < n) {
            System.out.print(arr[i] + " ");
            i++;
        }
    }
}


